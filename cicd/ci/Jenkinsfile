pipeline {
    agent {
        label 'agent-maven'
    }

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timeout(time: 20, unit: 'MINUTES')
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    environment {
        APP_NAME           = 'hello-world-api'
        APP_DIR            = 'app/hello-world-api'
        SMOKE_SCRIPT       = 'app/testing/smoke-test.sh'

        AWS_REGION         = 'ca-central-1'
        AWS_CREDENTIALS_ID = 'aws_credential'

        ECR_REGISTRY       = '099139718958.dkr.ecr.ca-central-1.amazonaws.com'
        ECR_REPOSITORY     = 'hello-world-api'
        IMAGE_URI          = "${ECR_REGISTRY}/${ECR_REPOSITORY}"

        CONTAINER_NAME     = 'hello-world-api-smoke'
        HOST_PORT          = '18080'
        SMOKE_PATH         = '/health'
        EXPECTED_TEXT      = '"status":"UP"'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    env.SHORT_COMMIT = sh(
                        script: 'git rev-parse --short HEAD',
                        returnStdout: true
                    ).trim()

                    env.IS_PRIMARY_BRANCH = (
                        env.BRANCH_NAME == 'main' || env.BRANCH_NAME == 'master'
                    ).toString()

                    echo "Branch: ${env.BRANCH_NAME}"
                    echo "Commit: ${env.SHORT_COMMIT}"
                    echo "Primary branch: ${env.IS_PRIMARY_BRANCH}"
                }
            }
        }

        stage('Test') {
            steps {
                container('maven') {
                    dir("${APP_DIR}") {
                        sh '''
                            set -eu
                            mvn -B test
                        '''
                    }
                }
            }
            post {
                always {
                    junit allowEmptyResults: true,
                          testResults: "${APP_DIR}/target/surefire-reports/*.xml"
                }
            }
        }

        stage('Docker Build') {
            steps {
                container('dind') {
                    dir("${APP_DIR}") {
                        sh '''
                            set -eu

                            for i in $(seq 1 30); do
                                docker info >/dev/null 2>&1 && break
                                echo "Waiting for Docker daemon... ($i/30)"
                                sleep 2
                            done

                            docker info >/dev/null 2>&1 || {
                                echo "Docker daemon never became ready"
                                exit 1
                            }

                            docker build \
                              -t ${IMAGE_URI}:${BUILD_NUMBER} \
                              -t ${IMAGE_URI}:${SHORT_COMMIT} \
                              .

                            if [ "${IS_PRIMARY_BRANCH}" = "true" ]; then
                                docker tag ${IMAGE_URI}:${SHORT_COMMIT} ${IMAGE_URI}:latest
                            fi
                        '''
                    }
                }
            }
        }

        // stage('Smoke Test') {
        //     steps {
        //         container('dind') {
        //             sh '''
        //                 set -eu
        //                 chmod +x "${SMOKE_SCRIPT}"

        //                 CONTAINER_NAME="${CONTAINER_NAME}" \
        //                 HOST_PORT="${HOST_PORT}" \
        //                 SMOKE_PATH="${SMOKE_PATH}" \
        //                 EXPECTED_TEXT="${EXPECTED_TEXT}" \
        //                 "${SMOKE_SCRIPT}" "${IMAGE_URI}:${SHORT_COMMIT}"
        //             '''
        //         }
        //     }
        // }

       stage('Push to ECR') { 
            steps { 
                container('dind') { 
                    script { 
                        retry(2) { 
                            docker.withRegistry( "https://${ECR_REGISTRY}", "ecr:${AWS_REGION}:aws_credential") { 
                                def img = docker.image("${IMAGE_URI}:${SHORT_COMMIT}") 
                                
                                img.push() 
                                img.push("${BUILD_NUMBER}") 
                                img.push("latest") 
                            } 
                        } 
                    } 
                } 
            } 
        } 
    }
    
    post {
        always {
            container('dind') {
                sh '''
                    set +e
                    docker rm -f "${CONTAINER_NAME}" >/dev/null 2>&1 || true
                    docker rmi "${IMAGE_URI}:${SHORT_COMMIT}" >/dev/null 2>&1 || true
                    docker rmi "${IMAGE_URI}:${BUILD_NUMBER}" >/dev/null 2>&1 || true
                    docker rmi "${IMAGE_URI}:latest" >/dev/null 2>&1 || true
                    docker logout "${ECR_REGISTRY}" >/dev/null 2>&1 || true
                '''
            }
        }

        success {
            script {
                if (env.IS_PRIMARY_BRANCH == 'true') {
                    echo "Image pushed successfully:"
                    echo "- ${IMAGE_URI}:${env.SHORT_COMMIT}"
                    echo "- ${IMAGE_URI}:${env.BUILD_NUMBER}"
                    echo "- ${IMAGE_URI}:latest"
                } else {
                    echo "Build, test, and smoke test passed. Push skipped for branch: ${env.BRANCH_NAME}"
                }
            }
        }

        failure {
            echo 'Pipeline failed. Check logs above.'
        }
    }
}