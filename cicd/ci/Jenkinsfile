pipeline {
    agent {
        label 'agent-maven'
    }

    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
        timeout(time: 20, unit: 'MINUTES')
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    environment {
        APP_NAME           = 'hello-world-api'
        APP_DIR            = 'app/hello-world-api'
        SMOKE_SCRIPT       = 'app/testing/smoke-test.sh'

        AWS_REGION         = 'ca-central-1'
        AWS_CREDENTIALS_ID = 'aws_credential'

        ECR_REGISTRY       = '099139718958.dkr.ecr.ca-central-1.amazonaws.com'
        ECR_REPOSITORY     = 'hello-world-api'
        IMAGE_URI          = "${ECR_REGISTRY}/${ECR_REPOSITORY}"

        CONTAINER_NAME     = 'hello-world-api-smoke'
        HOST_PORT          = '18080'
        CONTAINER_PORT     = '8080'
        SMOKE_PATH         = '/health'
        EXPECTED_TEXT      = '"status":"UP"'
        MAX_RETRIES        = '30'
        SLEEP_SECONDS      = '2'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    env.SHORT_COMMIT = sh(
                        script: 'git rev-parse --short HEAD',
                        returnStdout: true
                    ).trim()

                    echo "=========================================="
                    echo "BRANCH DETECTION:"
                    echo "=========================================="
                    echo "env.BRANCH_NAME: ${env.BRANCH_NAME}"
                    echo "env.GIT_BRANCH: ${env.GIT_BRANCH}"
                    sh 'git rev-parse --abbrev-ref HEAD'
                    sh 'git symbolic-ref --short HEAD || echo "Detached HEAD"'
                    echo "=========================================="
                    
                    env.IS_PRIMARY_BRANCH = (
                        env.BRANCH_NAME == 'main' || env.BRANCH_NAME == 'master'
                    ).toString()

                    echo "Branch: ${env.BRANCH_NAME}"
                    echo "Commit: ${env.SHORT_COMMIT}"
                    echo "Primary branch: ${env.IS_PRIMARY_BRANCH}"
                    echo "=========================================="
                }
            }
        }

        stage('Test') {
            steps {
                container('maven') {
                    dir("${APP_DIR}") {
                        sh '''
                            set -eu
                            echo "Running unit tests..."
                            mvn -B test
                            echo "✓ Unit tests passed"
                        '''
                    }
                }
            }
            post {
                always {
                    junit allowEmptyResults: true,
                          testResults: "${APP_DIR}/target/surefire-reports/*.xml"
                }
            }
        }

        stage('Docker Build') {
            steps {
                container('dind') {
                    dir("${APP_DIR}") {
                        sh '''
                            set -eu
                            
                            echo "Waiting for Docker daemon..."
                            for i in $(seq 1 30); do
                                docker info >/dev/null 2>&1 && break
                                echo "  Attempt $i/30..."
                                sleep 2
                            done

                            docker info >/dev/null 2>&1 || {
                                echo "ERROR: Docker daemon never became ready"
                                exit 1
                            }
                            echo "✓ Docker daemon ready"

                            echo "Building image with tags:"
                            echo "  - ${IMAGE_URI}:${BUILD_NUMBER}"
                            echo "  - ${IMAGE_URI}:${SHORT_COMMIT}"
                            
                            # Build with BUILD_NUMBER and SHORT_COMMIT tags
                            docker build \
                              -t ${IMAGE_URI}:${BUILD_NUMBER} \
                              -t ${IMAGE_URI}:${SHORT_COMMIT} \
                              .
                            
                            # Tag as 'latest' only on primary branch
                            if [ "${IS_PRIMARY_BRANCH}" = "true" ]; then
                                echo "  - ${IMAGE_URI}:latest (primary branch)"
                                docker tag ${IMAGE_URI}:${SHORT_COMMIT} ${IMAGE_URI}:latest
                            fi
                            
                            echo "✓ Docker image built successfully"
                        '''
                    }
                }
            }
        }

        stage('Push to ECR') {
            // Only push images when on master or main branch
            when {
                branch pattern: "(main|master)", comparator: "REGEXP"
            }
            steps {
                container('dind') {
                    script {
                        echo "Pushing image to ECR (${ECR_REGISTRY})..."
                        
                        retry(2) {
                            docker.withRegistry("https://${ECR_REGISTRY}", "ecr:${AWS_REGION}:${AWS_CREDENTIALS_ID}") {
                                def img = docker.image("${IMAGE_URI}:${SHORT_COMMIT}")
                                
                                echo "  Pushing tag: ${SHORT_COMMIT}"
                                img.push()
                                
                                echo "  Pushing tag: ${BUILD_NUMBER}"
                                img.push("${BUILD_NUMBER}")
                                
                                echo "  Pushing tag: latest"
                                img.push("latest")
                                
                                echo "✓ All tags pushed successfully to ECR"
                            }
                        }
                    }
                }
            }
        }
    }
    
    post {
        always {
            container('dind') {
                sh '''
                    set +e  # Don't fail on cleanup errors
                    
                    echo "=========================================="
                    echo "Cleanup: Removing Docker resources..."
                    echo "=========================================="
                    
                    # Remove test container (suppress "No such container" errors)
                    docker rm -f "${CONTAINER_NAME}" 2>&1 | grep -v "No such container" || true
                    echo "  ✓ Removed container: ${CONTAINER_NAME}"
                    
                    # Remove temporary images (suppress "No such image" errors)
                    docker rmi "${IMAGE_URI}:${SHORT_PORT}" 2>&1 | grep -v "No such image" || true
                    echo "  ✓ Removed image: ${SHORT_COMMIT}"
                    
                    docker rmi "${IMAGE_URI}:${BUILD_NUMBER}" 2>&1 | grep -v "No such image" || true
                    echo "  ✓ Removed image: ${BUILD_NUMBER}"
                    
                    # Only remove latest tag if it was created (primary branch)
                    if [ "${IS_PRIMARY_BRANCH}" = "true" ]; then
                        docker rmi "${IMAGE_URI}:latest" 2>&1 | grep -v "No such image" || true
                        echo "  ✓ Removed image: latest"
                    fi
                    
                    # Logout from ECR
                    docker logout "${ECR_REGISTRY}" >/dev/null 2>&1 || true
                    echo "  ✓ Logged out from ECR"
                    
                    echo "✓ Cleanup complete"
                '''
            }
        }

        success {
            script {
                if (env.IS_PRIMARY_BRANCH == 'true') {
                    echo "=========================================="
                    echo "✅ PIPELINE SUCCESS - Image pushed to ECR:"
                    echo "=========================================="
                    echo "Repository: ${ECR_REPOSITORY}"
                    echo "Tags:"
                    echo "  - ${IMAGE_URI}:${SHORT_COMMIT}"
                    echo "  - ${IMAGE_URI}:${BUILD_NUMBER}"
                    echo "  - ${IMAGE_URI}:latest"
                    echo "=========================================="
                } else {
                    echo "=========================================="
                    echo "✅ PIPELINE SUCCESS - Build validated:"
                    echo "=========================================="
                    echo "Branch: ${env.BRANCH_NAME} (not primary)"
                    echo "Build, test, and smoke test all passed."
                    echo "Image push skipped (only runs on main/master)."
                    echo "=========================================="
                }
            }
        }

        failure {
            echo "=========================================="
            echo "❌ PIPELINE FAILURE"
            echo "=========================================="
            echo "Check the logs above for details."
            echo "Common issues:"
            echo "  - Unit tests failed (see Test stage)"
            echo "  - Docker build failed (check Dockerfile)"
            echo "  - Smoke test failed (container/app not responding)"
            echo "  - ECR push failed (AWS credentials or network)"
            echo "=========================================="
        }

        unstable {
            echo "⚠️ Pipeline unstable - check logs for warnings"
        }
    }
}