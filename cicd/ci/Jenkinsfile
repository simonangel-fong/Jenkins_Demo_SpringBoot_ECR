pipeline {
    agent {
        label 'agent-maven'
    }

    options {
        disableConcurrentBuilds()
        timeout(time: 20, unit: 'MINUTES')
        timestamps()
    }

    environment {
        APP_NAME       = 'hello-world-api'
        APP_DIR        = 'app/hello-world-api'
        AWS_REGION     = 'ca-central-1'
        ECR_REGISTRY   = '099139718958.dkr.ecr.ca-central-1.amazonaws.com'
        ECR_REPOSITORY = 'hello-world-api'
        IMAGE_URI      = "${ECR_REGISTRY}/${ECR_REPOSITORY}"
        CONTAINER_NAME = 'hello-world-api-smoke'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    env.SHORT_COMMIT = sh(
                        script: 'git rev-parse --short HEAD',
                        returnStdout: true
                    ).trim()

                    env.IS_PRIMARY_BRANCH = (
                        env.BRANCH_NAME == 'main' || env.BRANCH_NAME == 'master'
                    ).toString()

                    echo "Branch: ${env.BRANCH_NAME}"
                    echo "Commit: ${env.SHORT_COMMIT}"
                    echo "Primary branch: ${env.IS_PRIMARY_BRANCH}"
                }
            }
        }

        stage('Test') {
            steps {
                container('maven') {
                    dir("${APP_DIR}") {
                        sh '''
                            set -eu
                            mvn -B test
                        '''
                    }
                }
            }
            post {
                always {
                    junit allowEmptyResults: true,
                          testResults: "${APP_DIR}/target/surefire-reports/*.xml"
                }
            }
        }

        stage('Docker Build') {
            steps {
                container('dind') {
                    dir("${APP_DIR}") {
                        sh '''
                            set -eu

                            for i in $(seq 1 30); do
                                docker info >/dev/null 2>&1 && break
                                echo "Waiting for Docker daemon... ($i/30)"
                                sleep 2
                            done

                            docker info >/dev/null 2>&1 || {
                                echo "Docker daemon never became ready"
                                exit 1
                            }

                            # Optional cache warm-up; do not fail if image does not exist
                            docker pull ${IMAGE_URI}:latest || true

                            docker build \
                              --cache-from ${IMAGE_URI}:latest \
                              -t ${IMAGE_URI}:${BUILD_NUMBER} \
                              -t ${IMAGE_URI}:${SHORT_COMMIT} \
                              .
                            
                            if [ "${IS_PRIMARY_BRANCH}" = "true" ]; then
                                docker tag ${IMAGE_URI}:${SHORT_COMMIT} ${IMAGE_URI}:latest
                            fi
                        '''
                    }
                }
            }
        }

        stage('Smoke Test') {
            steps {
                container('dind') {
                    sh '''
                        set -eu

                        docker rm -f ${CONTAINER_NAME} >/dev/null 2>&1 || true

                        docker run -d \
                          --name ${CONTAINER_NAME} \
                          -p 8080:8080 \
                          ${IMAGE_URI}:${SHORT_COMMIT}

                        # Wait for app startup
                        for i in $(seq 1 30); do
                            if curl -fsS http://127.0.0.1:8080/hello >/dev/null 2>&1; then
                                break
                            fi
                            echo "Waiting for application... ($i/30)"
                            sleep 2
                        done

                        curl -fsS http://127.0.0.1:8080/hello
                    '''
                }
            }
        }

        stage('Push to ECR') {
            when {
                anyOf {
                    branch 'main'
                    branch 'master'
                }
            }
            steps {
                container('dind') {
                    script {
                        retry(2) {
                            docker.withRegistry(
                                "https://${ECR_REGISTRY}",
                                "ecr:${AWS_REGION}:aws_credential"
                            ) {
                                def img = docker.image("${IMAGE_URI}:${SHORT_COMMIT}")
                                img.push()
                                img.push("${BUILD_NUMBER}")
                                img.push("latest")
                            }
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            container('dind') {
                sh '''
                    set +e
                    docker rm -f ${CONTAINER_NAME} >/dev/null 2>&1 || true
                    docker rmi ${IMAGE_URI}:${SHORT_COMMIT} >/dev/null 2>&1 || true
                    docker rmi ${IMAGE_URI}:${BUILD_NUMBER} >/dev/null 2>&1 || true
                    docker rmi ${IMAGE_URI}:latest >/dev/null 2>&1 || true
                '''
            }
        }

        success {
            script {
                if (env.IS_PRIMARY_BRANCH == 'true') {
                    echo "Image pushed: ${IMAGE_URI}:${env.SHORT_COMMIT}"
                } else {
                    echo "Build/test/smoke passed. Push skipped for branch: ${env.BRANCH_NAME}"
                }
            }
        }

        failure {
            echo 'Pipeline failed. Check logs above.'
        }
    }
}