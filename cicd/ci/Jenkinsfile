pipeline {
    agent {
        label 'agent-maven'
    }

    options {
        disableConcurrentBuilds()
        timeout(time: 20, unit: 'MINUTES')
    }

    environment {
        APP_NAME       = 'hello-world-api'
        APP_DIR        = 'app/hello-world-api'
        AWS_REGION     = 'ca-central-1'
        ECR_REGISTRY   = '099139718958.dkr.ecr.ca-central-1.amazonaws.com'
        ECR_REPOSITORY = 'hello-world-api'
        IMAGE_URI      = "${ECR_REGISTRY}/${ECR_REPOSITORY}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    env.SHORT_COMMIT = sh(
                        script: "git rev-parse --short HEAD",
                        returnStdout: true
                    ).trim()
                }
            }
        }

        stage('Test') {
            steps {
                container('maven') {
                    dir("${APP_DIR}") {
                        sh '''
                            set -eux
                            mvn -B test        # -B = batch/non-interactive, cleaner logs
                        '''
                    }
                }
            }
            post {
                always {
                    junit allowEmptyResults: true,
                          testResults: "${APP_DIR}/target/surefire-reports/*.xml"
                }
            }
        }

        stage('Docker Build') {
            steps {
                container('dind') {
                    dir("${APP_DIR}") {
                        sh '''
                            set -eux

                            # Wait for daemon — with a timeout so it doesn't hang forever
                            for i in $(seq 1 30); do
                                docker info >/dev/null 2>&1 && break
                                echo "Waiting for Docker daemon... ($i/30)"
                                sleep 2
                            done
                            docker info >/dev/null 2>&1 || { echo "Docker daemon never became ready"; exit 1; }

                            docker build \
                              --cache-from ${IMAGE_URI}:latest \
                              -t ${IMAGE_URI}:${BUILD_NUMBER} \
                              -t ${IMAGE_URI}:${SHORT_COMMIT} \
                              -t ${IMAGE_URI}:latest \
                              .
                        '''
                    }
                }
            }
        }

        stage('Push to ECR') {
            steps {
                container('dind') {
                    script {
                        docker.withRegistry(
                            "https://${ECR_REGISTRY}",
                            "ecr:${AWS_REGION}:aws_credential"   // ecr: prefix is key
                        ) {
                            def img = docker.image("${IMAGE_URI}:${SHORT_COMMIT}")
                            img.push()
                            img.push("${BUILD_NUMBER}")
                            img.push("latest")
                        }
                    }
                }
            }
        }
    }

    post {
        success {
            echo "Image pushed: ${IMAGE_URI}:${env.SHORT_COMMIT}"
        }
        failure {
            echo 'Pipeline failed. Check logs above.'
        }
    }
}